{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["jest", "node"],
    // Allows importing the __mocks__ stub as if it were the real package.
    "paths": {
      "obsidian": ["./__mocks__/obsidian.ts"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "__mocks__/**/*",
    "jest.setup.ts"
  ]
}